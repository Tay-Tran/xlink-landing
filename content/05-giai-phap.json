{
  "khoi": "03 · Giải pháp – 3 trụ cột",
  "items": [
    {
      "id": "giai-phap-001",
      "loai": "Đoạn chữ",
      "vi": "Giải pháp tổng thể",
      "en": "The complete solution"
    },
    {
      "id": "giai-phap-002",
      "loai": "Tiêu đề khối",
      "vi": "One platform. Connected people. Better performance.",
      "en": "One platform. Connected people. Better performance."
    },
    {
      "id": "giai-phap-003",
      "loai": "Đoạn chữ",
      "vi": "XLINK là nền tảng quản trị nguồn lực tích hợp HRM, quản trị hiệu suất, quản trị năng lực, đào tạo và AI Assistant. Thay vì nhiều công cụ rời rạc, dữ liệu và nghiệp vụ nằm trên cùng một hệ thống, để các cấp quản lý và nhân viên phối hợp hiệu quả hơn.",
      "en": "XLINK is a people management platform that brings together HRM, performance management, competency management, training and an AI Assistant. Instead of scattered tools, data and processes live in one system, so managers and employees work together more effectively."
    },
    {
      "id": "giai-phap-004",
      "loai": "Tiêu đề nhỏ",
      "vi": "HR Operations",
      "en": "HR Operations"
    },
    {
      "id": "giai-phap-005",
      "loai": "Đoạn chữ",
      "vi": "Vận hành nhân sự thông minh",
      "en": "Smart HR operations"
    },
    {
      "id": "giai-phap-006",
      "loai": "Đoạn chữ",
      "vi": "Số hóa toàn bộ nghiệp vụ, từ tổ chức, hồ sơ, tuyển dụng, chấm công, nghỉ phép, tiền lương đến tiếp nhận và nghỉ việc.",
      "en": "Digitize every HR process, from organization, profiles, recruiting, attendance and leave to payroll, onboarding and offboarding."
    },
    {
      "id": "giai-phap-007",
      "loai": "Ý / dòng",
      "vi": "Chuẩn hóa dữ liệu nhân sự tập trung",
      "en": "Centralized, standardized HR data"
    },
    {
      "id": "giai-phap-008",
      "loai": "Ý / dòng",
      "vi": "Kết nối quy trình và luồng phê duyệt",
      "en": "Connected processes and approval flows"
